# Backend
BACKEND_ENV=development
BACKEND_PORT=8000

# Zhipu AI
# Do not commit real API keys. Copy this file to .env and replace the placeholder locally.
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4-plus

# External APIs
EPA_COMPTOX_API_KEY=your_epa_comptox_api_key_here

# Database
DATABASE_URL=postgresql://biology:biology@localhost:5432/biology_demo

# Cache
REDIS_URL=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
